  <property name="windowTitle">
   <string>Customisation</string>
  </property>
  <layout class="QVBoxLayout">
   <item>
    <widget class="QGroupBox" name="qgbChatHistory">
     <property name="toolTip">
      <string>Saves channel chat to a file on this computer and shows the latest messages again after a restart. Messages are stored as plain text.</string>
     </property>
     <property name="title">
      <string>Save channel chat to disk</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <layout class="QGridLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="qlChatHistoryMax">
        <property name="text">
         <string>Maximum saved messages</string>
        </property>
        <property name="buddy">
         <cstring>qsbChatHistoryMax</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="qsbChatHistoryMax">
        <property name="toolTip">
         <string>Older saved messages are deleted when Mumble starts.</string>
        </property>
        <property name="specialValueText">
         <string>Unlimited</string>
        </property>
        <property name="maximum">
         <number>1000000</number>
        </property>
        <property name="singleStep">
         <number>100</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="qlChatHistoryRestore">
        <property name="text">
         <string>Messages shown at startup</string>
        </property>
        <property name="buddy">
         <cstring>qsbChatHistoryRestore</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="qsbChatHistoryRestore">
        <property name="specialValueText">
         <string>All saved</string>
        </property>
        <property name="maximum">
         <number>1000000</number>
        </property>
        <property name="singleStep">
         <number>50</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="qcbChatHistoryImages">
        <property name="toolTip">
         <string>Inline images make the saved file much larger. When unchecked they are saved as "[image]".</string>
        </property>
        <property name="text">
         <string>Also save inline images</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="qlChatHistoryDirectory">
        <property name="text">
         <string>Save folder</string>
        </property>
        <property name="buddy">
         <cstring>qleChatHistoryDirectory</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLineEdit" name="qleChatHistoryDirectory">
          <property name="toolTip">
           <string>Folder where the saved chat file is kept. Leave empty to use Mumble's data folder. Existing saved chat is not moved.</string>
          </property>
          <property name="placeholderText">
           <string>Default (Mumble's data folder)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="qpbChatHistoryBrowse">
          <property name="text">
           <string>Browse...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QPushButton" name="qpbClearChatHistory">
        <property name="toolTip">
         <string>Deletes the saved chat file right away, without needing Apply.</string>
        </property>
        <property name="text">
         <string>Delete saved chat now</string>
        </property>
       </widget>
      </item>
